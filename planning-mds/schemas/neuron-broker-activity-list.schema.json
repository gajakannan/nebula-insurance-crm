{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nebula.local/schemas/neuron-broker-activity-list.schema.json",
  "title": "NeuronBrokerActivityListProps",
  "description": "Props for the registered Neuron component broker_activity.recent_list (F0040). Carries one through twenty authorization-scoped Broker ActivityTimelineEvents in newest-first order. Empty results use a typed empty zone/message rather than an empty content component.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "entityType",
          "entityId",
          "eventType",
          "eventDescription",
          "entityName",
          "actorDisplayName",
          "occurredAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "entityType": { "const": "Broker" },
          "entityId": { "type": "string", "format": "uuid" },
          "eventType": { "type": "string", "minLength": 1 },
          "eventDescription": { "type": "string", "minLength": 1, "maxLength": 500 },
          "entityName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "actorDisplayName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
